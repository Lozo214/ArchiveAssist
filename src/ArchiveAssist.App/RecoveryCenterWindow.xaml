<Window x:Class="ArchiveAssist.App.RecoveryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recovery Center - Archive Assist"
        Width="1040"
        Height="650"
        MinWidth="820"
        MinHeight="500"
        Background="#F4F6F8"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinWidth" Value="95" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#17212B"
                       Text="Recovery Center" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#5D6873"
                       TextWrapping="Wrap"
                       Text="Restore files without navigating backup folders. Archive Assist manages these recovery files privately and removes them according to your retention preference." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,14"
                Padding="12"
                Background="#EAF3F9"
                BorderBrush="#9FC4DD"
                BorderThickness="1"
                CornerRadius="5">
            <TextBlock x:Name="RetentionText"
                       Foreground="#214D68"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="RecoveryGrid"
                      AutomationProperties.Name="Managed recovery points"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="RecoveryGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedLabel}"
                                        Width="135" />
                    <DataGridTextColumn Header="File"
                                        Binding="{Binding FileName}"
                                        Width="210" />
                    <DataGridTextColumn Header="Operation"
                                        Binding="{Binding Operation}"
                                        Width="165" />
                    <DataGridTextColumn Header="Original Folder"
                                        Binding="{Binding Folder}"
                                        Width="*" />
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeLabel}"
                                        Width="85" />
                    <DataGridTextColumn Header="Expires"
                                        Binding="{Binding ExpiresLabel}"
                                        Width="145" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusLabel}"
                                        Width="135" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#3D4B55"
                           Text="No recovery points are available." />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#6B7680"
                           Text="Recovery points appear here after a safely managed in-place save." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RestoreButton"
                        Content="Restore"
                        IsEnabled="False"
                        Background="#1769AA"
                        Foreground="White"
                        Click="Restore_Click" />
                <Button x:Name="OpenCurrentButton"
                        Margin="8,0,0,0"
                        Content="Open current file"
                        IsEnabled="False"
                        Click="OpenCurrent_Click" />
                <Button x:Name="DeleteButton"
                        Margin="8,0,0,0"
                        Content="Delete recovery"
                        IsEnabled="False"
                        Click="Delete_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Clean expired"
                        Click="CleanExpired_Click" />
                <Button Margin="8,0,0,0"
                        Content="Refresh"
                        Click="Refresh_Click" />
                <Button Margin="8,0,0,0"
                        Content="Close"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#5D6873"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
