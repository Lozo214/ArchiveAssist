<Window x:Class="ArchiveAssist.App.CropPagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Crop selected pages"
        Height="760"
        Width="980"
        MinHeight="620"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="CropHandleStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#1769AA" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Width="230" Margin="18,0,0,14">
                <TextBlock Text="Preview zoom" FontWeight="SemiBold" Foreground="#17212B" />
                <Slider x:Name="CropZoomSlider"
                        Minimum="0.2"
                        Maximum="3"
                        Value="1"
                        TickFrequency="0.1"
                        ValueChanged="CropZoomChanged" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Choose the visible page area"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#17212B" />
                <TextBlock Margin="0,6,0,4"
                           Foreground="#5D6873"
                           TextWrapping="Wrap"
                           Text="Drag the blue rectangle or its handles. The same margins will be applied to every selected page." />
                <TextBlock Foreground="#5D6873"
                           Text="Hold Ctrl and use the mouse wheel to zoom the preview." />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="#D9E0E4"
                BorderBrush="#C7D0D5"
                BorderThickness="1">
            <ScrollViewer x:Name="CropScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="CropScrollViewerPreviewMouseWheel">
                <Canvas x:Name="CropCanvas" Background="#BFC8CE">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="CropCanvasScaleTransform" ScaleX="1" ScaleY="1" />
                    </Canvas.LayoutTransform>

                    <Image x:Name="PageImage"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           Stretch="None"
                           SnapsToDevicePixels="True" />

                    <Rectangle x:Name="CropRectangle"
                               Stroke="#1769AA"
                               StrokeThickness="3"
                               Fill="#331769AA"
                               MouseLeftButtonDown="CropRectangleMouseDown"
                               MouseLeftButtonUp="CropRectangleMouseUp"
                               MouseMove="CropRectangleMouseMove" />

                    <primitives:Thumb x:Name="TopLeftHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeNWSE"
                                      DragDelta="TopLeftHandleDragDelta" />
                    <primitives:Thumb x:Name="TopHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeNS"
                                      DragDelta="TopHandleDragDelta" />
                    <primitives:Thumb x:Name="TopRightHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeNESW"
                                      DragDelta="TopRightHandleDragDelta" />
                    <primitives:Thumb x:Name="RightHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeWE"
                                      DragDelta="RightHandleDragDelta" />
                    <primitives:Thumb x:Name="BottomLeftHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeNESW"
                                      DragDelta="BottomLeftHandleDragDelta" />
                    <primitives:Thumb x:Name="BottomHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeNS"
                                      DragDelta="BottomHandleDragDelta" />
                    <primitives:Thumb x:Name="BottomRightHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeNWSE"
                                      DragDelta="BottomRightHandleDragDelta" />
                    <primitives:Thumb x:Name="LeftHandle"
                                      Style="{StaticResource CropHandleStyle}"
                                      Cursor="SizeWE"
                                      DragDelta="LeftHandleDragDelta" />
                </Canvas>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    MinWidth="90"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelClicked" />
            <Button Content="Apply crop"
                    MinWidth="105"
                    Padding="12,8"
                    IsDefault="True"
                    Click="OkClicked" />
        </StackPanel>
    </Grid>
</Window>
