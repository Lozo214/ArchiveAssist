<Window x:Class="ArchiveAssist.App.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Page Equalizer - Archive Assist" Height="680" Width="940"
        MinHeight="560" MinWidth="760" WindowStartupLocation="CenterOwner"
        Background="#F4F6F8" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="105" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE2E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PDF Page Equalizer" FontSize="25" FontWeight="SemiBold" Foreground="#17212B" />
            <TextBlock Margin="0,5,0,0" Foreground="#5D6873" TextWrapping="Wrap"
                       Text="Preview and rebuild only folders containing an over-limit PDF. Each folder stays separate, pages remain in alphabetical file order, and source PDFs are never changed." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Source folder:" FontWeight="SemiBold" />
            <TextBox x:Name="SourceFolderTextBox" Grid.Column="1" Margin="10,0,8,0" Padding="9,7"
                     IsReadOnly="True" Background="White" />
            <Button x:Name="SelectSourceFolderButton" Grid.Column="2" Padding="13,6"
                    Content="Select folder..." Click="SelectSourceFolderButton_Click" />
            <TextBlock Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center"
                       Text="Max pages:" FontWeight="SemiBold" />
            <TextBox x:Name="MaxPagesTextBox" Grid.Column="4" Margin="10,0,0,0" Padding="9,7"
                     Background="White" TextAlignment="Right" TextChanged="MaxPagesTextBox_TextChanged" />
        </Grid>

        <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="0,14,0,0">
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Foreground="#5D6873" Text="Source PDFs" /><TextBlock x:Name="SourceFilesText" FontSize="20" FontWeight="SemiBold" Text="-" /></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Foreground="#5D6873" Text="Source pages" /><TextBlock x:Name="SourcePagesText" FontSize="20" FontWeight="SemiBold" Text="-" /></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Foreground="#5D6873" Text="Over limit" /><TextBlock x:Name="OverLimitText" FontSize="20" FontWeight="SemiBold" Text="-" /></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Foreground="#5D6873" Text="Folders rebuilt" /><TextBlock x:Name="FoldersText" FontSize="20" FontWeight="SemiBold" Text="-" /></StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0">
                <StackPanel><TextBlock Foreground="#5D6873" Text="Output PDFs" /><TextBlock x:Name="OutputFilesText" FontSize="20" FontWeight="SemiBold" Text="-" /></StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Grid.Row="3" Margin="0,15,0,7">
            <TextBlock Text="Folder plan" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="PreviewButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Padding="13,6" Content="Preview plan" Click="PreviewButton_Click" />
        </DockPanel>

        <DataGrid x:Name="FolderPlansGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7F9FA"
                  Background="White" BorderBrush="#D5DBE1" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Folder" Binding="{Binding RelativeFolder}" Width="*" />
                <DataGridTextColumn Header="PDFs" Binding="{Binding SourceFiles}" Width="75" />
                <DataGridTextColumn Header="Pages" Binding="{Binding SourcePages}" Width="85" />
                <DataGridTextColumn Header="Over limit" Binding="{Binding FilesOverLimit}" Width="90" />
                <DataGridTextColumn Header="Output PDFs" Binding="{Binding ExpectedOutputFiles}" Width="100" />
                <DataGridTextColumn Header="Action" Binding="{Binding ActionLabel}" Width="115" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="OperationProgressBar" Height="6" Minimum="0" Maximum="1" />
            <TextBlock x:Name="OperationStatusText" Grid.Row="1" Margin="0,6,0,0"
                       Foreground="#5D6873" Text="Preparing preview..." TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,15,0,0">
            <TextBlock MaxWidth="430" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#5D6873" TextWrapping="Wrap"
                       Text="The automatic manifest is a technical audit trail for generated pages; it is not a Report export." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenOutputButton" Content="Open output" IsEnabled="False" Click="OpenOutputButton_Click" />
                <Button x:Name="CancelButton" Margin="8,0,0,0" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" />
                <Button x:Name="RunButton" Margin="8,0,0,0" Content="Create equalized PDFs"
                        MinWidth="170" IsEnabled="False" Background="#1769AA" Foreground="White"
                        Click="RunButton_Click" />
                <Button Margin="8,0,0,0" Content="Close" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
