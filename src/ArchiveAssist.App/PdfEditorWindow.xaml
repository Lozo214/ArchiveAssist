<Window x:Class="ArchiveAssist.App.PdfEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArchiveAssist.App.Controls"
        Title="Archive Assist PDF Editor"
        Height="860"
        Width="1280"
        MinHeight="680"
        MinWidth="920"
        Background="#F4F6F8"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ViewToggleStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BFC8CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F1F8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#1769AA" />
                                <Setter Property="BorderBrush" Value="#1769AA" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F1F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DDEEF9" />
                                <Setter Property="BorderBrush" Value="#1769AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationPageItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F1F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DDEEF9" />
                                <Setter Property="BorderBrush" Value="#1769AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="White"
              BorderBrush="#D5DBE1"
              BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Open PDF..." InputGestureText="Ctrl+O" Click="OpenPdfMenuItem_Click" />
                <MenuItem x:Name="RecentPdfsMenuItem"
                          Header="Open _Recent PDF"
                          SubmenuOpened="RecentPdfsMenuItem_SubmenuOpened">
                    <MenuItem Header="(No recent PDFs)" IsEnabled="False" />
                </MenuItem>
                <MenuItem x:Name="SaveMenuItem"
                          Header="_Save"
                          InputGestureText="Ctrl+S"
                          IsEnabled="False"
                          Click="SaveMenuItem_Click" />
                <MenuItem Header="Save a Cop_y..."
                          Click="SaveCopyMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="OpenBackupFolderMenuItem"
                          Header="Open _Recovery Center"
                          IsEnabled="False"
                          Click="OpenRecoveryCenter_Click" />
                <MenuItem x:Name="RestoreBackupMenuItem"
                          Header="_Restore Original..."
                          IsEnabled="False"
                          Click="RestoreBackup_Click" />
                <Separator />
                <MenuItem Header="_Close" Click="CloseMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenuItem"
                          Header="_Undo"
                          InputGestureText="Ctrl+Z"
                          IsEnabled="False"
                          Click="Undo_Click" />
                <MenuItem x:Name="RedoMenuItem"
                          Header="_Redo"
                          InputGestureText="Ctrl+Y"
                          IsEnabled="False"
                          Click="Redo_Click" />
                <Separator />
                <MenuItem Header="Select _All Pages"
                          InputGestureText="Ctrl+A"
                          Click="SelectAll_Click" />
                <Separator />
                <MenuItem x:Name="RotateLeftMenuItem"
                          Header="Rotate selected pages _left"
                          IsEnabled="False"
                          Click="RotateLeft_Click" />
                <MenuItem x:Name="RotateRightMenuItem"
                          Header="Rotate selected pages _right"
                          IsEnabled="False"
                          Click="RotateRight_Click" />
                <MenuItem x:Name="CropMenuItem"
                          Header="_Crop selected pages..."
                          IsEnabled="False"
                          Click="Crop_Click" />
                <MenuItem x:Name="DeleteMenuItem"
                          Header="_Delete selected pages"
                          InputGestureText="Delete"
                          IsEnabled="False"
                          Click="Delete_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Thumbnail Grid"
                          InputGestureText="Ctrl+1"
                          Click="GridViewToggle_Click" />
                <MenuItem Header="_Page View"
                          InputGestureText="Ctrl+2"
                          Click="PageViewToggle_Click" />
                <Separator />
                <MenuItem Header="Fit _Page"
                          InputGestureText="Ctrl+0"
                          Click="FitPage_Click" />
                <MenuItem Header="Fit _Width"
                          InputGestureText="Ctrl+Shift+0"
                          Click="FitWidth_Click" />
                <MenuItem Header="Zoom _In"
                          InputGestureText="Ctrl++"
                          Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _Out"
                          InputGestureText="Ctrl+-"
                          Click="ZoomOut_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Getting Started" Click="ShowGettingStarted_Click" />
                <MenuItem Header="_Keyboard Shortcuts" Click="KeyboardShortcuts_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Padding="14,11"
                Background="White"
                BorderBrush="#D5DBE1"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource EditorButtonStyle}"
                        Content="Open PDF..."
                        ToolTip="Open a PDF (Ctrl+O)"
                        Click="OpenPdfMenuItem_Click" />
                <Button x:Name="UndoButton"
                        Style="{StaticResource CompactButtonStyle}"
                        Content="Undo"
                        ToolTip="Undo the last edit (Ctrl+Z)"
                        IsEnabled="False"
                        Click="Undo_Click" />
                <Button x:Name="RedoButton"
                        Style="{StaticResource CompactButtonStyle}"
                        Content="Redo"
                        ToolTip="Redo the last undone edit (Ctrl+Y)"
                        IsEnabled="False"
                        Click="Redo_Click" />
                <Separator Width="1" Margin="3,3,10,3" Background="#D5DBE1" />
                <Button x:Name="RotateLeftButton"
                        Style="{StaticResource EditorButtonStyle}"
                        Content="Rotate left"
                        ToolTip="Rotate selected pages counterclockwise"
                        IsEnabled="False"
                        Click="RotateLeft_Click" />
                <Button x:Name="RotateRightButton"
                        Style="{StaticResource EditorButtonStyle}"
                        Content="Rotate right"
                        ToolTip="Rotate selected pages clockwise"
                        IsEnabled="False"
                        Click="RotateRight_Click" />
                <Button x:Name="CropButton"
                        Style="{StaticResource EditorButtonStyle}"
                        Content="Crop..."
                        ToolTip="Crop all selected pages"
                        IsEnabled="False"
                        Click="Crop_Click" />
                <Button x:Name="DeleteButton"
                        Style="{StaticResource EditorButtonStyle}"
                        Content="Delete"
                        ToolTip="Delete selected pages (Delete)"
                        IsEnabled="False"
                        Click="Delete_Click" />
                <Button x:Name="SaveButton"
                        Padding="16,8"
                        MinWidth="105"
                        Content="Save"
                        ToolTip="Save changes to the opened PDF (Ctrl+S)"
                        Background="#1769AA"
                        Foreground="White"
                        IsEnabled="False"
                        Click="SaveMenuItem_Click" />
            </StackPanel>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DocumentNameText"
                                   Text="No PDF open"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#17212B"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SaveStateText"
                                   Margin="12,4,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#5D6873"
                                   FontWeight="SemiBold"
                                   Text="No document" />
                    </StackPanel>
                    <TextBlock x:Name="DocumentPathText"
                               Margin="0,3,0,0"
                               Foreground="#5D6873"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="16,0,0,0"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="#FFF4CE"
                        BorderBrush="#E6C75A"
                        BorderThickness="1"
                        CornerRadius="5">
                    <TextBlock Foreground="#6B5300"
                               Text="Save updates the opened PDF and keeps its original version in Recovery Center." />
                </Border>
            </Grid>

            <Border x:Name="EditorWelcomePanel"
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    Padding="14,11"
                    Background="#E8F1F8"
                    BorderBrush="#8CB6D3"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#17496A"
                                   Text="Getting started with the PDF Editor" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#315B73"
                                   TextWrapping="Wrap"
                                   Text="Use Thumbnail Grid for batch edits. Drag selected pages to reorder them. Ctrl+S safely updates the opened PDF; Save a Copy remains available from File." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="18,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Padding="11,6"
                                Margin="0,0,7,0"
                                Content="Shortcuts"
                                Click="KeyboardShortcuts_Click" />
                        <Button Padding="11,6"
                                Content="Got it"
                                Click="DismissGettingStarted_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D5DBE1"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="10,8"
                            Background="#F8F9FA"
                            BorderBrush="#D5DBE1"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="GridViewToggle"
                                              Style="{StaticResource ViewToggleStyle}"
                                              Content="Thumbnail Grid"
                                              IsChecked="True"
                                              ToolTip="Batch-select and manage pages (Ctrl+1)"
                                              Click="GridViewToggle_Click" />
                                <ToggleButton x:Name="PageViewToggle"
                                              Style="{StaticResource ViewToggleStyle}"
                                              Content="Page View"
                                              ToolTip="Inspect one page closely (Ctrl+2)"
                                              Click="PageViewToggle_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ViewDescriptionText"
                                       Grid.Column="1"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="#5D6873"
                                       Text="Batch-select pages for editing, then drag them to reorder." />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="RescanReportButton"
                                        Margin="0,0,7,0"
                                        Padding="11,6"
                                        Content="Close and Rescan"
                                        ToolTip="Close the editor and rerun the current Archive Assist scan"
                                        Visibility="Collapsed"
                                        Click="RescanReport_Click" />
                                <Button x:Name="OpenBackupFolderButton"
                                        Margin="0,0,7,0"
                                        Padding="11,6"
                                        Content="Recovery Center"
                                        ToolTip="Review and restore managed recovery points"
                                        Visibility="Collapsed"
                                        Click="OpenRecoveryCenter_Click" />
                                <Button x:Name="RestoreBackupButton"
                                        Padding="11,6"
                                        Content="Restore Original"
                                        ToolTip="Restore the original session recovery point; the currently saved edited version is preserved"
                                        Visibility="Collapsed"
                                        Click="RestoreBackup_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="EmptyStateText"
                               Grid.Row="1"
                               Panel.ZIndex="5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#5D6873"
                               FontSize="17"
                               Text="Open a PDF to view and edit its pages." />

                    <Grid x:Name="ThumbnailGridPanel" Grid.Row="1">
                        <ListBox x:Name="PageThumbnailList"
                                 Padding="8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource PageItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="PDF page thumbnail grid"
                                 PreviewMouseWheel="PageThumbnailList_PreviewMouseWheel"
                                 ScrollViewer.ScrollChanged="PageList_ScrollChanged"
                                 PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PageList_PreviewMouseMove"
                                 DragOver="PageList_DragOver"
                                 DragLeave="PageList_DragLeave"
                                 Drop="PageList_Drop"
                                 SelectionChanged="PageThumbnailList_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ThumbnailSize="150"
                                                                      CacheRows="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="{Binding CardWidth}">
                                        <Border Padding="10"
                                                Background="White"
                                                BorderBrush="#9CAAB2"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <StackPanel>
                                                <Border Background="#F0F3F5"
                                                        BorderBrush="#C7D0D5"
                                                        BorderThickness="1">
                                                    <Grid Width="{Binding ThumbnailWidth}"
                                                          Height="{Binding ThumbnailHeight}">
                                                        <TextBlock Padding="8"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#71808A"
                                                                   FontSize="11"
                                                                   Text="{Binding PreviewLabel}" />
                                                        <Image Source="{Binding ThumbnailImage}"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0"
                                                           TextAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="#5D6873"
                                                           Text="{Binding EditSummary}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,7,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17212B"
                                                   Text="{Binding PageNumber}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid x:Name="PageViewPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#F8F9FA"
                                BorderBrush="#D5DBE1"
                                BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="12,10,12,5"
                                           FontWeight="SemiBold"
                                           Foreground="#17212B"
                                           Text="Pages" />
                                <ListBox x:Name="PageNavigationList"
                                         ItemsSource="{Binding ElementName=PageThumbnailList, Path=ItemsSource}"
                                         SelectionMode="Single"
                                         ItemContainerStyle="{StaticResource NavigationPageItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         AllowDrop="True"
                                         AutomationProperties.Name="Page navigation thumbnails"
                                         ScrollViewer.ScrollChanged="PageList_ScrollChanged"
                                         PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="PageList_PreviewMouseMove"
                                         DragOver="PageList_DragOver"
                                         DragLeave="PageList_DragLeave"
                                         Drop="PageList_Drop"
                                         SelectionChanged="PageNavigationList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Height="132"
                                                        Background="#EEF1F3"
                                                        BorderBrush="#BFC8CE"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#71808A"
                                                                   FontSize="10"
                                                                   Text="Loading..." />
                                                        <Image Source="{Binding ThumbnailImage}"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Margin="0,5,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding PageNumber}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="DetailToolbar"
                                    Grid.Row="1"
                                    Padding="10,8"
                                    Background="White"
                                    BorderBrush="#D5DBE1"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailEditSummaryText"
                                               Grid.Column="0"
                                               Margin="4,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="#5D6873"
                                               Text="No page selected" />

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button x:Name="PreviousPageButton"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Content="Previous"
                                                ToolTip="Previous page (Page Up)"
                                                Click="PreviousPage_Click" />
                                        <TextBlock x:Name="PagePositionText"
                                                   Margin="5,0,10,0"
                                                   MinWidth="110"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="Page 0 of 0" />
                                        <Button x:Name="NextPageButton"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Content="Next"
                                                ToolTip="Next page (Page Down)"
                                                Click="NextPage_Click" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource CompactButtonStyle}"
                                                Content="Fit Page"
                                                ToolTip="Fit the entire page (Ctrl+0)"
                                                Click="FitPage_Click" />
                                        <Button Style="{StaticResource CompactButtonStyle}"
                                                Content="Fit Width"
                                                ToolTip="Fit page width (Ctrl+Shift+0)"
                                                Click="FitWidth_Click" />
                                        <Button Style="{StaticResource CompactButtonStyle}"
                                                Content="−"
                                                FontSize="17"
                                                ToolTip="Zoom out (Ctrl+-)"
                                                Click="ZoomOut_Click" />
                                        <Slider x:Name="DetailZoomSlider"
                                                Width="150"
                                                Minimum="10"
                                                Maximum="800"
                                                Value="100"
                                                TickFrequency="25"
                                                VerticalAlignment="Center"
                                                ToolTip="Page zoom"
                                                ValueChanged="DetailZoomSlider_ValueChanged" />
                                        <TextBlock x:Name="DetailZoomText"
                                                   Width="52"
                                                   Margin="7,0,3,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="100%" />
                                        <Button Style="{StaticResource CompactButtonStyle}"
                                                Content="+"
                                                FontSize="17"
                                                ToolTip="Zoom in (Ctrl++)"
                                                Click="ZoomIn_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="PageViewScrollViewer"
                                          Grid.Row="0"
                                          Background="#DCE2E6"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="Both"
                                          Cursor="Arrow"
                                          AutomationProperties.Name="Detailed PDF page preview"
                                          SizeChanged="PageViewScrollViewer_SizeChanged"
                                          PreviewMouseWheel="PageViewScrollViewer_PreviewMouseWheel"
                                          PreviewMouseLeftButtonDown="PageViewScrollViewer_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="PageViewScrollViewer_PreviewMouseLeftButtonUp"
                                          PreviewMouseMove="PageViewScrollViewer_PreviewMouseMove"
                                          LostMouseCapture="PageViewScrollViewer_LostMouseCapture">
                                <Grid x:Name="DetailPageSurface"
                                      Margin="28"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailEmptyText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#5D6873"
                                               FontSize="16"
                                               Text="Select a page to inspect it." />
                                    <Border x:Name="DetailPageBorder"
                                            Padding="1"
                                            Background="White"
                                            BorderBrush="#89979F"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <Image x:Name="DetailPageImage"
                                               Stretch="Fill"
                                               SnapsToDevicePixels="True" />
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Foreground="#5D6873"
                               Text="Tip: Select one or more pages, then drag them to reorder." />
                    <ProgressBar x:Name="RenderProgressBar"
                                 Margin="0,6,20,0"
                                 Height="5"
                                 Minimum="0"
                                 Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="ThumbnailZoomPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="#5D6873"
                               Text="Ctrl + mouse wheel zooms" />
                    <TextBlock Margin="12,0,10,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Thumbnail size" />
                    <Slider x:Name="ThumbnailZoomSlider"
                            Width="190"
                            Minimum="100"
                            Maximum="1000"
                            Value="150"
                            TickFrequency="50"
                            ToolTip="Enlarge thumbnails up to 1000 pixels. Large previews may look pixelated."
                            ValueChanged="ThumbnailZoomSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
