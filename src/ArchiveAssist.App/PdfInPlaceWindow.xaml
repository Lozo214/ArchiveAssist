<Window x:Class="ArchiveAssist.App.PdfInPlaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1020" Height="800" MinWidth="860" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Heading}" />
            <TextBlock Margin="0,5,0,0" Foreground="#5D6873" TextWrapping="Wrap"
                       Text="{Binding Description}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12"
                Background="#FFF4CE" BorderBrush="#E2B93B" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="Bold" Foreground="#7A4D00" Text="Important: " />
                <TextBlock Foreground="#7A4D00" TextWrapping="Wrap" Text="{Binding WarningText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12"
                Background="#F3F6F8" BorderBrush="#D8DEE4" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="OCRmyPDF Setup Check" />
                    <TextBlock Margin="0,3,12,6" Foreground="#5D6873" TextWrapping="Wrap"
                               Text="{Binding SetupInstructions}" />
                    <ItemsControl ItemsSource="{Binding Dependencies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="8,4" Background="White"
                                        BorderBrush="#C9D1D9" BorderThickness="1"
                                        ToolTip="{Binding Details}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="6,0,0,0" Text="{Binding StatusLabel}" />
                                        <TextBlock Margin="5,0,0,0" Foreground="#6B7680"
                                                   Text="{Binding Version}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Padding="13,6"
                        Content="Recheck setup" Command="{Binding CheckSetupCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button MinWidth="150" Padding="13,6" Content="Select PDFs/folders..."
                        Click="SelectFiles_Click" IsEnabled="{Binding CanEditQueue}" />
                <Button MinWidth="125" Margin="8,0,0,0" Padding="13,6" Content="Remove selected"
                        Click="RemoveSelected_Click" IsEnabled="{Binding CanEditQueue}" />
                <Button MinWidth="75" Margin="8,0,0,0" Padding="13,6" Content="Clear"
                        Click="Clear_Click" IsEnabled="{Binding CanEditQueue}" />
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#5D6873"
                           Text="{Binding TotalFiles, StringFormat={}{0:N0} PDF file(s) queued}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0"
                  Visibility="{Binding IsOptimization, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Optimization:" />
                <ComboBox Grid.Column="1" Margin="10,0" Padding="7,5"
                          ItemsSource="{Binding OptimizationLevels}"
                          SelectedItem="{Binding SelectedOptimization}"
                          DisplayMemberPath="Name" IsEnabled="{Binding CanEditQueue}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#5D6873"
                           TextWrapping="Wrap" Text="{Binding OptimizationDescription}" />
            </Grid>
        </Grid>

        <TabControl x:Name="ProcessingTabs" Grid.Row="4" Margin="0,14,0,0">
            <TabItem Header="Queue">
                <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Queue}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="250" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="90" />
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Results">
                <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="210" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StateLabel}" Width="145" />
                        <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="65" />
                        <DataGridTextColumn Header="Before" Binding="{Binding OriginalSizeLabel}" Width="85" />
                        <DataGridTextColumn Header="After" Binding="{Binding FinalSizeLabel}" Width="85" />
                        <DataGridTextColumn Header="Saved" Binding="{Binding SavingsLabel}" Width="115" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar Height="10" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="#5D6873" Text="{Binding CurrentStage}" />
                        <TextBlock Margin="8,0,0,0" Foreground="#5D6873"
                                   FontWeight="SemiBold" Text="{Binding CurrentFileName}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="#5D6873"
                               Text="{Binding ElapsedText}" />
                </Grid>
                <TextBlock Margin="0,3,0,0" Foreground="#7A858F"
                           Text="{Binding CurrentDetail}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CurrentDetail}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button MinWidth="95" Padding="13,7" Content="Cancel"
                        Command="{Binding CancelCommand}" />
                <Button MinWidth="145" Margin="8,0,0,0" Padding="13,7"
                        Content="{Binding StartButtonText}" Click="Start_Click"
                        IsEnabled="{Binding CanStart}" IsDefault="True" />
            </StackPanel>
        </Grid>

        <Border x:Name="CompletionPanel"
                Grid.Row="6"
                Margin="0,12,0,0"
                Padding="12"
                Background="#EAF5EC"
                BorderBrush="#8CC398"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CompletionSummaryText"
                           Foreground="#245B31"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="UndoLastButton"
                            MinWidth="110"
                            Padding="12,7"
                            Content="Undo last"
                            Click="UndoLast_Click" />
                    <Button Margin="8,0,0,0"
                            MinWidth="130"
                            Padding="12,7"
                            Content="Recovery Center"
                            Click="RecoveryCenter_Click" />
                    <Button Margin="8,0,0,0"
                            MinWidth="80"
                            Padding="12,7"
                            Content="Dismiss"
                            Click="DismissCompletion_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="7" Margin="0,10,0,0">
            <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
            <TextBlock Margin="0,3,0,0" Foreground="#5D6873"
                       TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
        </StackPanel>
    </Grid>
</Window>
