<Window x:Class="ArchiveAssist.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive Assist Preferences"
        Width="720"
        Height="570"
        MinWidth="650"
        MinHeight="520"
        Background="#F4F6F8"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#27333C" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="MinWidth" Value="95" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212B" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                Background="White"
                BorderBrush="#D5DBE1"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
                <Button Content="Save preferences"
                        IsDefault="True"
                        Background="#1769AA"
                        Foreground="White"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

        <TabControl Margin="18" Background="White">
            <TabItem Header="Scan Defaults">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Default scan settings" />
                        <TextBlock Text="These values are used when Archive Assist opens. You can still change them before each scan."
                                   TextWrapping="Wrap"
                                   Foreground="#5D6873" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Pages count as maps when larger than" />
                        <ComboBox x:Name="ThresholdCombo"
                                  Width="270"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"
                                  AutomationProperties.Name="Default map size threshold" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Maximum pages per PDF" />
                        <TextBox x:Name="MaxPagesTextBox"
                                 Width="100"
                                 HorizontalAlignment="Left"
                                 Padding="8,6"
                                 AutomationProperties.Name="Default maximum PDF pages" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Default QA mode" />
                        <ComboBox x:Name="QaModeCombo"
                                  Width="270"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"
                                  SelectionChanged="QaModeCombo_SelectionChanged"
                                  AutomationProperties.Name="Default QA mode" />
                        <TextBlock x:Name="QaModeDescriptionText"
                                   Width="540"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Foreground="#5D6873" />

                        <CheckBox x:Name="AdvancedExpandedCheckBox"
                                  Margin="0,20,0,0"
                                  Content="Keep advanced scan settings expanded on the main window" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Report">
                <StackPanel Margin="22">
                    <TextBlock Style="{StaticResource SectionHeading}"
                               Text="Report and Excel handoff" />
                    <CheckBox x:Name="IncludeHeadersCheckBox"
                              Content="Include column headers when copying rows for Excel" />
                    <TextBlock Margin="0,7,0,18"
                               Text="Filters, search text, column widths, and sorting are remembered automatically."
                               TextWrapping="Wrap"
                               Foreground="#5D6873" />
                    <Button Width="180"
                            HorizontalAlignment="Left"
                            Content="Reset report layout"
                            Click="ResetReportLayout_Click" />
                    <TextBlock x:Name="ReportResetText"
                               Margin="0,8,0,0"
                               Foreground="#26703A" />

                    <Separator Margin="0,24,0,18" />
                    <TextBlock Style="{StaticResource SectionHeading}"
                               Text="Getting started guidance" />
                    <CheckBox x:Name="ShowMainWelcomeCheckBox"
                              Content="Show main-window getting started guidance next time" />
                    <CheckBox x:Name="ShowEditorWelcomeCheckBox"
                              Margin="0,10,0,0"
                              Content="Show PDF Editor getting started guidance next time" />
                </StackPanel>
            </TabItem>

            <TabItem Header="File Safety">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Style="{StaticResource SectionHeading}"
                                   Text="Saving and recovery" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#5D6873"
                                   Text="Archive Assist can update the file you are already viewing while privately retaining a restorable recovery point." />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Default PDF Editor save behavior" />
                        <ComboBox x:Name="FileSafetyModeCombo"
                                  Width="330"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"
                                  SelectionChanged="FileSafetyModeCombo_SelectionChanged"
                                  AutomationProperties.Name="Default file safety mode">
                            <ComboBoxItem Tag="SafeInPlace"
                                          Content="Safe in-place (recommended)" />
                            <ComboBoxItem Tag="AlwaysAsk"
                                          Content="Ask each time" />
                            <ComboBoxItem Tag="SaveCopies"
                                          Content="Save edited copies" />
                        </ComboBox>
                        <TextBlock x:Name="SafetyModeDescriptionText"
                                   Width="560"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Foreground="#5D6873" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Margin="0,22,0,5"
                                   Text="Keep recovery points for" />
                        <ComboBox x:Name="RecoveryRetentionCombo"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Padding="8,6"
                                  AutomationProperties.Name="Recovery retention period">
                            <ComboBoxItem Tag="7" Content="7 days" />
                            <ComboBoxItem Tag="30" Content="30 days (recommended)" />
                            <ComboBoxItem Tag="90" Content="90 days" />
                            <ComboBoxItem Tag="0" Content="Until I delete them" />
                        </ComboBox>
                        <TextBlock Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#5D6873"
                                   Text="Expired recovery points are cleaned automatically when Archive Assist starts. You can also review, restore, and delete them from File > Recovery Center." />

                        <Border Margin="0,22,0,0"
                                Padding="13"
                                Background="#EAF3F9"
                                BorderBrush="#9FC4DD"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBlock Foreground="#214D68"
                                       TextWrapping="Wrap"
                                       Text="Experimental OCR and optimization always verify their output and ask before replacing originals. Successful replacements use the same managed Recovery Center." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="PDF Editor">
                <StackPanel Margin="22">
                    <TextBlock Style="{StaticResource SectionHeading}"
                               Text="PDF Editor defaults" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Opening view" />
                    <ComboBox x:Name="EditorViewCombo"
                              Width="220"
                              HorizontalAlignment="Left"
                              Padding="8,6">
                        <ComboBoxItem Tag="ThumbnailGrid" Content="Thumbnail Grid" />
                        <ComboBoxItem Tag="Page" Content="Page View" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Thumbnail size" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="EditorThumbnailSlider"
                                Width="300"
                                Minimum="100"
                                Maximum="1000"
                                TickFrequency="50"
                                IsSnapToTickEnabled="False" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ElementName=EditorThumbnailSlider, Path=Value, StringFormat={}{0:0} px}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detailed page zoom" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="EditorDetailSlider"
                                Width="300"
                                Minimum="10"
                                Maximum="800"
                                TickFrequency="25" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ElementName=EditorDetailSlider, Path=Value, StringFormat={}{0:0}%}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Experimental">
                <StackPanel Margin="22">
                    <TextBlock Style="{StaticResource SectionHeading}"
                               Text="Experimental PDF processing" />
                    <Border Padding="14"
                            Background="#FFF4CE"
                            BorderBrush="#E6C75A"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#6B5300"
                                   Text="OCR and optimization remain available for testing, but OCR development is currently paused. Results may be slower or less accurate than dedicated commercial OCR tools. Always review the verified backup and output behavior before production use." />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               Text="The PDF Page Equalizer and built-in PDF Editor are separate from these experimental OCRmyPDF-based tools." />
                    <TextBlock Margin="0,24,0,0"
                               Foreground="#5D6873"
                               TextWrapping="Wrap"
                               Text="Archive Assist follows Windows display scaling and high-contrast settings. Keyboard shortcuts are available from the Help menu." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
