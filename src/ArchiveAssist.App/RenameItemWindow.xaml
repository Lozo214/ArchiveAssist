<Window x:Class="ArchiveAssist.App.RenameItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename - Archive Assist"
        Width="500"
        Height="245"
        MinWidth="430"
        MinHeight="220"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                Background="White"
                BorderBrush="#D5DBE1"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button MinWidth="90"
                        Padding="13,7"
                        Content="Cancel"
                        IsCancel="True" />
                <Button MinWidth="90"
                        Margin="8,0,0,0"
                        Padding="13,7"
                        Background="#1769AA"
                        Foreground="White"
                        Content="Rename"
                        IsDefault="True"
                        Click="Rename_Click" />
            </StackPanel>
        </Border>

        <StackPanel Margin="22">
            <TextBlock x:Name="HeadingText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#17212B" />
            <TextBlock x:Name="GuidanceText"
                       Margin="0,6,0,14"
                       Foreground="#5D6873"
                       TextWrapping="Wrap" />
            <TextBox x:Name="NewNameTextBox"
                     Padding="9,7"
                     AutomationProperties.Name="New file or folder name" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,7,0,0"
                       Foreground="#B3261E"
                       TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
