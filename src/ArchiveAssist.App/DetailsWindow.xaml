<Window x:Class="ArchiveAssist.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Details" Width="780" Height="570" MinWidth="620" MinHeight="420"
        Background="#F4F6F8" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding FileName}" FontSize="20" FontWeight="SemiBold" Foreground="#17212B" />
            <TextBlock Margin="0,5,0,0" Text="{Binding FullPath}" Foreground="#5D6873"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#D5DBE1">
            <TabItem Header="{Binding InformationTabLabel}">
                <DataGrid ItemsSource="{Binding InformationFields}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F7F9FA" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="190" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Scan Details">
                <DataGrid ItemsSource="{Binding ScanFields}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F7F9FA" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="190" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open file" Padding="16,8" Click="OpenFileButton_Click" />
            <Button Margin="8,0,0,0" Content="Open containing folder" Padding="16,8"
                    Click="OpenFolderButton_Click" />
            <Button Margin="8,0,0,0" Content="Close" Padding="16,8" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
