<Window x:Class="ArchiveAssist.App.ScanSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Files and Folders - Archive Assist"
        Width="780" Height="510" MinWidth="620" MinHeight="410"
        Background="#F4F6F8" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="MinWidth" Value="105" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Choose what to scan" FontSize="24" FontWeight="SemiBold" Foreground="#17212B" />
            <TextBlock x:Name="DescriptionText" Margin="0,5,0,0" Foreground="#5D6873" TextWrapping="Wrap"
                       Text="Add any combination of files and folders. Selected folders are scanned recursively, and overlapping selections are counted only once." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,10" Orientation="Horizontal">
            <Button Content="Add files..." Click="AddFilesButton_Click" />
            <Button Margin="8,0,0,0" Content="Add folders..." Click="AddFoldersButton_Click" />
            <Button Margin="8,0,0,0" Content="Remove selected" Click="RemoveSelectedButton_Click" />
            <Button Margin="8,0,0,0" Content="Clear" Click="ClearButton_Click" />
        </StackPanel>

        <DataGrid x:Name="SelectionGrid" Grid.Row="2" ItemsSource="{Binding Selections}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F7F9FA" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="90" />
                <DataGridTextColumn Header="Full path" Binding="{Binding FullPath}" Width="4*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Foreground="#5D6873" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button x:Name="UseSelectionButton" Margin="8,0,0,0" Content="Use selection"
                        Background="#1769AA" Foreground="White" IsDefault="True"
                        Click="UseSelectionButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
